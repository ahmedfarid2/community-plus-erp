[options]
; Master password — rendered from MASTER_PASSWORD in .env.production.
admin_passwd = __MASTER_PASSWORD__

addons_path = /mnt/extra-addons

db_host = db
db_port = 5432
db_user = odoo

; SECURITY: never expose the database manager on a public server.
list_db = False

; MULTI-TENANT: each subdomain maps to its own company database.
; acme.<domain> -> database "acme". %d = first subdomain label.
dbfilter = ^%d$

; Behind the nginx reverse proxy.
proxy_mode = True

; Performance — tune to the server. Rule of thumb: workers = (2 * CPU) + 1.
workers = 4
limit_time_cpu  = 600
limit_time_real = 1200
limit_request   = 8192
limit_memory_soft = 2147483648
limit_memory_hard = 2684354560
