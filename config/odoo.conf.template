[options]
; Master password — guards the database manager (create / drop / backup DBs).
; This value is injected from MASTER_PASSWORD in .env by scripts/start.sh.
admin_passwd = __MASTER_PASSWORD__

; Where custom modules are mounted (see docker-compose.yml).
; Includes third-party open-source modules under odoomates/ (fetched by
; scripts/dev/fetch-oca.sh). Odoo scans each path for module folders.
addons_path = /mnt/extra-addons,/mnt/extra-addons/odoomates,/mnt/extra-addons/oca/web,/mnt/extra-addons/oca/reporting-engine,/mnt/extra-addons/oca/server-tools,/mnt/extra-addons/oca/server-ux,/mnt/extra-addons/oca/mis-builder,/mnt/extra-addons/oca/account-financial-tools,/mnt/extra-addons/oca/bank-statement-import,/mnt/extra-addons/oca/account-reconcile,/mnt/extra-addons/oca/queue,/mnt/extra-addons/oca/partner-contact,/mnt/extra-addons/oca/sale-workflow,/mnt/extra-addons/oca/stock-logistics-workflow,/mnt/extra-addons/oca/crm,/mnt/extra-addons/oca/hr

; Database connection. db_password is intentionally NOT set here so the Odoo
; image entrypoint supplies it from the PASSWORD env var (kept in one place: .env).
db_host = db
db_port = 5432
db_user = odoo

; Show the database selector so each company picks its own DB at login.
list_db = True

; Behind the nginx reverse proxy — trust X-Forwarded-* headers.
proxy_mode = True

; --- Multi-tenant by subdomain (opt-in) ---------------------------------
; Uncomment to map each company subdomain to its own database, so
; https://acme.odoo.local serves ONLY the "acme" database (no selector).
; Direct http://localhost:8069 keeps the full database manager for admin.
; %d = first subdomain of the request host.
; dbfilter = ^%d$

; Reasonable local timeouts (raise for big imports).
limit_time_cpu = 600
limit_time_real = 1200
