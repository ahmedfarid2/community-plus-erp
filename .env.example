# ── Odoo Community local stack — environment ───────────────────────────────
# Copy this file to ".env" and adjust as needed:  cp .env.example .env

# Image versions (pinned for reproducibility)
ODOO_TAG=19.0
PG_TAG=16

# Ports exposed on your Mac (http://localhost:<ODOO_PORT>)
ODOO_PORT=8069
ODOO_CHAT_PORT=8072

# nginx reverse proxy ports (https://<company>.odoo.local).
# Switch to 8080/8443 if 80/443 collide with another reverse proxy.
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL password (local only — change for anything public)
POSTGRES_PASSWORD=odoo

# Odoo master password — protects the database manager (create/drop/backup DBs).
# Injected into config/odoo.conf by scripts/start.sh. CHANGE THIS.
MASTER_PASSWORD=change-me-master
