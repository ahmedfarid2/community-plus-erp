<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cpq_configuration_list" model="ir.ui.view">
        <field name="name">cpq.configuration.list</field>
        <field name="model">cpq.configuration</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'validated'"
                  decoration-info="state == 'quoted'"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="margin_percent &lt; 15 and state != 'cancelled'">
                <field name="name"/>
                <field name="template_id"/>
                <field name="partner_id"/>
                <field name="user_id" optional="show"/>
                <field name="quantity"/>
                <field name="total_price" sum="Total"/>
                <field name="margin_percent" string="Margin %"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-info="state == 'quoted'"/>
            </list>
        </field>
    </record>

    <record id="view_cpq_configuration_form" model="ir.ui.view">
        <field name="name">cpq.configuration.form</field>
        <field name="model">cpq.configuration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object"
                            string="Validate Configuration" class="btn-primary"
                            invisible="state not in ('draft',)"/>
                    <button name="action_recalculate" type="object"
                            string="Recalculate Price"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state in ('draft','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,validated,quoted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <label for="width" string="Dimensions (W×H×L)"/>
                            <div class="o_row">
                                <field name="width"/> ×
                                <field name="height"/> ×
                                <field name="length"/>
                                <field name="area" readonly="1"/>
                            </div>
                        </group>
                    </group>
                    <field name="validation_message" readonly="1"
                           invisible="not validation_message"
                           class="text-muted"/>
                    <notebook>
                        <page string="Options" name="options">
                            <field name="selected_option_ids" widget="many2many_tags"
                                   readonly="state not in ('draft',)"
                                   options="{'no_create': True}"/>
                            <separator string="Configured Lines"/>
                            <field name="configuration_line_ids">
                                <list>
                                    <field name="group_id"/>
                                    <field name="option_id"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Calculation Log" name="logs">
                            <field name="log_ids">
                                <list>
                                    <field name="description"/>
                                    <field name="rule_id"/>
                                    <field name="amount_before"/>
                                    <field name="price_delta"/>
                                    <field name="amount_after"/>
                                    <field name="message"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="base_price"/>
                        <field name="options_price"/>
                        <field name="rules_price"/>
                        <field name="discount_amount"/>
                        <field name="total_price" class="oe_subtotal_footer_separator"/>
                        <field name="cost_total"/>
                        <field name="margin_amount"/>
                        <field name="margin_percent"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cpq_configuration_search" model="ir.ui.view">
        <field name="name">cpq.configuration.search</field>
        <field name="model">cpq.configuration</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="my_configs" string="My Configurations"
                        domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="validated" string="Validated"
                        domain="[('state','=','validated')]"/>
                <filter name="quoted" string="Quoted"
                        domain="[('state','=','quoted')]"/>
                <separator/>
                <filter name="low_margin" string="Low Margin"
                        domain="[('margin_percent','&lt;',15),('state','!=','cancelled')]"/>
                <filter name="this_month" string="This Month"
                        domain="[('create_date','&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_template" string="Template"
                        context="{'group_by':'template_id'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by':'state'}"/>
                <filter name="group_user" string="Salesperson"
                        context="{'group_by':'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cpq_configuration" model="ir.actions.act_window">
        <field name="name">Configurations</field>
        <field name="res_model">cpq.configuration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cpq_configuration_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure your first quote</p>
            <p>Pick a template, choose options, and let the engine validate the
               selection and calculate the price.</p>
        </field>
    </record>

</odoo>
