<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dashboards_lite_board_form" model="ir.ui.view">
        <field name="name">dashboards.lite.board.form</field>
        <field name="model">dashboards.lite.board</field>
        <field name="arch" type="xml">
            <form string="Company Dashboard" create="false" edit="false">
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <div class="o_cpdash">

                    <div class="o_cpdash_hero d-flex justify-content-between align-items-center">
                        <div>
                            <p class="o_cpdash_hero_title">
                                <field name="company_name" readonly="1" nolabel="1"/>
                            </p>
                            <span class="o_cpdash_hero_sub">Company Dashboard · live KPIs across every app</span>
                        </div>
                        <button name="action_refresh" type="object" string="Refresh"
                                class="btn btn-light" icon="fa-refresh"/>
                    </div>

                    <!-- Finance -->
                    <div class="o_cpdash_section"><i class="fa fa-money" title="Finance"/>Finance</div>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-info"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-university" title="Cash"/></div>
                                <div class="o_cpdash_label">Cash &amp; Bank</div>
                                <div class="o_cpdash_value"><field name="cash"/></div>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-success"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-hand-o-down" title="Receivable"/></div>
                                <div class="o_cpdash_label">Receivable</div>
                                <div class="o_cpdash_value"><field name="receivable"/></div>
                                <button name="action_receivable" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-danger"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-hand-o-up" title="Payable"/></div>
                                <div class="o_cpdash_label">Payable</div>
                                <div class="o_cpdash_value"><field name="payable"/></div>
                                <button name="action_payable" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-primary"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-line-chart" title="Net Profit"/></div>
                                <div class="o_cpdash_label">Net Profit (YTD)</div>
                                <div class="o_cpdash_value"><field name="net_profit_ytd"/></div>
                            </div></div>
                        </div>
                    </div>

                    <!-- Sales &amp; People -->
                    <div class="o_cpdash_section"><i class="fa fa-shopping-cart" title="Sales"/>Sales &amp; People</div>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-warning"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-file-text-o" title="Unpaid"/></div>
                                <div class="o_cpdash_label">Unpaid Invoices</div>
                                <div class="o_cpdash_value"><field name="unpaid_invoices"/></div>
                                <button name="action_unpaid_invoices" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-info"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-repeat" title="MRR"/></div>
                                <div class="o_cpdash_label">MRR</div>
                                <div class="o_cpdash_value"><field name="mrr"/></div>
                                <button name="action_subscriptions" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-success"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-tags" title="Quotations"/></div>
                                <div class="o_cpdash_label">Open Quotations</div>
                                <div class="o_cpdash_value"><field name="open_quotations"/></div>
                                <button name="action_quotations" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-slate"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-users" title="Employees"/></div>
                                <div class="o_cpdash_label">Employees</div>
                                <div class="o_cpdash_value"><field name="employees"/></div>
                                <button name="action_employees" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                    </div>

                    <!-- Operations -->
                    <div class="o_cpdash_section"><i class="fa fa-cogs" title="Operations"/>Operations</div>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-danger"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-life-ring" title="Tickets"/></div>
                                <div class="o_cpdash_label">Open Tickets</div>
                                <div class="o_cpdash_value"><field name="open_tickets"/></div>
                                <button name="action_tickets" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-warning"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-check-square-o" title="Approvals"/></div>
                                <div class="o_cpdash_label">Pending Approvals</div>
                                <div class="o_cpdash_value"><field name="pending_approvals"/></div>
                                <button name="action_approvals" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-purple"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-exclamation-triangle" title="Expiring"/></div>
                                <div class="o_cpdash_label">Expiring Documents</div>
                                <div class="o_cpdash_value"><field name="expiring_docs"/></div>
                                <button name="action_expiring_docs" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="o_cpdash_card accent-info"><div class="o_cpdash_body">
                                <div class="o_cpdash_icon"><i class="fa fa-calendar" title="Bookings"/></div>
                                <div class="o_cpdash_label">Today's Room Bookings</div>
                                <div class="o_cpdash_value"><field name="todays_bookings"/></div>
                                <button name="action_bookings" type="object" class="o_cpdash_link">View →</button>
                            </div></div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="action_dashboards_lite_board" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">dashboards.lite.board</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_dashboards_lite_root" name="Dashboards"
              web_icon="account,static/description/icon.png" sequence="1"/>
    <menuitem id="menu_dashboards_lite_board" name="Company Dashboard"
              parent="menu_dashboards_lite_root" action="action_dashboards_lite_board"
              sequence="10"/>

</odoo>
