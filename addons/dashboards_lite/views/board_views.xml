<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dashboards_lite_board_form" model="ir.ui.view">
        <field name="name">dashboards.lite.board.form</field>
        <field name="model">dashboards.lite.board</field>
        <field name="arch" type="xml">
            <form string="Company Dashboard" create="false" edit="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh"
                            class="btn-primary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>

                    <h3 class="text-primary"><i class="fa fa-money me-2"/>Finance</h3>
                    <div class="row g-3 mb-2">
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-university fa-2x text-info" title="KPI"/>
                                    <div class="text-muted small mt-2">Cash &amp; Bank</div>
                                    <h2 class="text-info mb-0"><field name="cash"/></h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-hand-o-down fa-2x text-success" title="KPI"/>
                                    <div class="text-muted small mt-2">Receivable</div>
                                    <h2 class="text-success mb-0"><field name="receivable"/></h2>
                                    <button name="action_receivable" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-hand-o-up fa-2x text-danger" title="KPI"/>
                                    <div class="text-muted small mt-2">Payable</div>
                                    <h2 class="text-danger mb-0"><field name="payable"/></h2>
                                    <button name="action_payable" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-line-chart fa-2x text-primary" title="KPI"/>
                                    <div class="text-muted small mt-2">Net Profit (YTD)</div>
                                    <h2 class="text-primary mb-0"><field name="net_profit_ytd"/></h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3 class="text-primary"><i class="fa fa-shopping-cart me-2"/>Sales &amp; People</h3>
                    <div class="row g-3 mb-2">
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-file-text-o fa-2x text-warning" title="KPI"/>
                                    <div class="text-muted small mt-2">Unpaid Invoices</div>
                                    <h3 class="mb-0"><field name="unpaid_invoices"/></h3>
                                    <button name="action_unpaid_invoices" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-repeat fa-2x text-info" title="KPI"/>
                                    <div class="text-muted small mt-2">MRR</div>
                                    <h3 class="mb-0"><field name="mrr"/></h3>
                                    <button name="action_subscriptions" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-tags fa-2x text-success" title="KPI"/>
                                    <div class="text-muted small mt-2">Open Quotations</div>
                                    <h3 class="mb-0"><field name="open_quotations"/></h3>
                                    <button name="action_quotations" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-users fa-2x text-secondary" title="KPI"/>
                                    <div class="text-muted small mt-2">Employees</div>
                                    <h3 class="mb-0"><field name="employees"/></h3>
                                    <button name="action_employees" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3 class="text-primary"><i class="fa fa-cogs me-2"/>Operations</h3>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-life-ring fa-2x text-danger" title="KPI"/>
                                    <div class="text-muted small mt-2">Open Tickets</div>
                                    <h3 class="mb-0"><field name="open_tickets"/></h3>
                                    <button name="action_tickets" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-check-square-o fa-2x text-warning" title="KPI"/>
                                    <div class="text-muted small mt-2">Pending Approvals</div>
                                    <h3 class="mb-0"><field name="pending_approvals"/></h3>
                                    <button name="action_approvals" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-exclamation-triangle fa-2x text-danger" title="KPI"/>
                                    <div class="text-muted small mt-2">Expiring Documents</div>
                                    <h3 class="mb-0"><field name="expiring_docs"/></h3>
                                    <button name="action_expiring_docs" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-body text-center">
                                    <i class="fa fa-calendar fa-2x text-info" title="KPI"/>
                                    <div class="text-muted small mt-2">Today's Room Bookings</div>
                                    <h3 class="mb-0"><field name="todays_bookings"/></h3>
                                    <button name="action_bookings" type="object"
                                            class="btn btn-sm btn-link p-0">View →</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dashboards_lite_board" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">dashboards.lite.board</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_dashboards_lite_root" name="Dashboards"
              web_icon="account,static/description/icon.png" sequence="1"/>
    <menuitem id="menu_dashboards_lite_board" name="Company Dashboard"
              parent="menu_dashboards_lite_root" action="action_dashboards_lite_board"
              sequence="10"/>

</odoo>
