<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_planning_lite_calendar" model="ir.ui.view">
        <field name="name">planning.lite.slot.calendar</field>
        <field name="model">planning.lite.slot</field>
        <field name="arch" type="xml">
            <calendar string="Planning" date_start="start_datetime"
                      date_stop="end_datetime" color="employee_id" mode="week">
                <field name="employee_id"/>
                <field name="name"/>
            </calendar>
        </field>
    </record>

    <record id="view_planning_lite_list" model="ir.ui.view">
        <field name="name">planning.lite.slot.list</field>
        <field name="model">planning.lite.slot</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'published'">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="allocated_hours" sum="Hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_planning_lite_form" model="ir.ui.view">
        <field name="name">planning.lite.slot.form</field>
        <field name="model">planning.lite.slot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish &amp; Notify"
                            class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="allocated_hours"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_planning_lite" model="ir.actions.act_window">
        <field name="name">Schedule</field>
        <field name="res_model">planning.lite.slot</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <menuitem id="menu_planning_lite_root" name="Planning"
              web_icon="planning_lite,static/description/icon.png" sequence="96"/>
    <menuitem id="menu_planning_lite_schedule" name="Schedule"
              parent="menu_planning_lite_root" action="action_planning_lite" sequence="10"/>

</odoo>
