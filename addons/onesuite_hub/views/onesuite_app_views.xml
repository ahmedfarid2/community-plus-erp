<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_onesuite_app_kanban" model="ir.ui.view">
        <field name="name">onesuite.app.kanban</field>
        <field name="model">onesuite.app</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="description"/>
                <field name="category"/>
                <field name="url"/>
                <field name="icon"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="cp_card cp-primary">
                            <div class="cp_card_body">
                                <div class="cp_icon">
                                    <i t-att-class="'fa ' + (record.icon.raw_value || 'fa-th-large')" title="Application"/>
                                </div>
                                <div class="fw-bold fs-5 mb-1"><field name="name"/></div>
                                <div class="text-muted small mb-2"><field name="description"/></div>
                                <div class="small mb-3">
                                    <span class="badge text-bg-light"><field name="category"/></span>
                                    <span class="badge text-bg-light"><field name="status"/></span>
                                </div>
                                <button name="action_open" type="object" string="Open"
                                        class="btn btn-primary btn-sm"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_onesuite_app_list" model="ir.ui.view">
        <field name="name">onesuite.app.list</field>
        <field name="model">onesuite.app</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="url"/>
                <field name="status"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_onesuite_app_form" model="ir.ui.view">
        <field name="name">onesuite.app.form</field>
        <field name="model">onesuite.app</field>
        <field name="arch" type="xml">
            <form string="OneSuite Application">
                <header>
                    <button name="action_open" type="object" string="Open Application" class="btn-primary"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="category"/>
                            <field name="url" widget="url"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="sequence"/>
                            <field name="open_new_tab"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onesuite_hub" model="ir.actions.act_window">
        <field name="name">OneSuite Hub</field>
        <field name="res_model">onesuite.app</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_onesuite_hub_root"
              name="OneSuite Hub"
              action="action_onesuite_hub"
              sequence="2"/>

    <menuitem id="menu_onesuite_hub_config"
              name="Applications"
              parent="menu_onesuite_hub_root"
              action="action_onesuite_hub"
              groups="base.group_system"
              sequence="90"/>
</odoo>
