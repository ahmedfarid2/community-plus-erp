<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_form_approval" model="ir.ui.view">
        <field name="name">subscription.subscription.form.approval</field>
        <field name="model">subscription.subscription</field>
        <field name="inherit_id" ref="smart_subscription_manager.view_subscription_form"/>
        <field name="arch" type="xml">
            <button name="action_open_cancel_wizard" position="after">
                <button name="action_view_cancel_approval" type="object"
                        string="View Cancellation Approval"
                        invisible="not approval_request_id"/>
            </button>
            <field name="health" position="after">
                <field name="approval_request_id" invisible="1"/>
                <field name="approval_state" widget="badge"
                       invisible="approval_state == 'none'"
                       decoration-info="approval_state == 'pending'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'rejected'"
                       decoration-warning="approval_state == 'to_request'"/>
            </field>
        </field>
    </record>

</odoo>
