<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ma_lite_campaign_list" model="ir.ui.view">
        <field name="name">marketing.lite.campaign.list</field>
        <field name="model">marketing.lite.campaign</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'running'" decoration-muted="state == 'stopped'">
                <field name="name"/>
                <field name="activity_count" string="Steps"/>
                <field name="participant_count" string="Participants"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_ma_lite_campaign_form" model="ir.ui.view">
        <field name="name">marketing.lite.campaign.form</field>
        <field name="model">marketing.lite.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state == 'running'"/>
                    <button name="action_stop" type="object" string="Stop"
                            invisible="state != 'running'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="domain" widget="domain"
                               options="{'model': 'res.partner'}"/>
                        <field name="participant_count"/>
                    </group>
                    <notebook>
                        <page string="Workflow">
                            <field name="activity_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="activity_type"/>
                                    <field name="trigger_type"/>
                                    <field name="interval_number"/>
                                    <field name="interval_unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Participants">
                            <field name="participant_ids">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ma_lite_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">marketing.lite.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ma_lite_root" name="Marketing Automation"
              web_icon="marketing_automation_lite,static/description/icon.png" sequence="102"/>
    <menuitem id="menu_ma_lite_campaigns" name="Campaigns"
              parent="menu_ma_lite_root" action="action_ma_lite_campaign" sequence="10"/>

</odoo>
