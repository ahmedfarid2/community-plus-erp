<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_social_lite_post_form" model="ir.ui.view">
        <field name="name">social.lite.post.form</field>
        <field name="model">social.lite.post</field>
        <field name="arch" type="xml">
            <form string="Social Post">
                <header>
                    <button name="action_post" type="object" string="Publish"
                            class="btn-primary" invisible="state == 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="account_ids" widget="many2many_tags"/>
                        <field name="link_url"/>
                    </group>
                    <field name="message" placeholder="What's on your mind?"/>
                    <field name="result" readonly="1" invisible="not result"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_social_lite_post_list" model="ir.ui.view">
        <field name="name">social.lite.post.list</field>
        <field name="model">social.lite.post</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'posted'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="account_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_social_lite_account_form" model="ir.ui.view">
        <field name="name">social.lite.account.form</field>
        <field name="model">social.lite.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Add your platform API token. Facebook Pages publish via the
                        Graph API once a Page ID + Page Access Token are set.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="platform"/>
                        <field name="target_id"/>
                        <field name="access_token" password="True"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_social_lite_account_list" model="ir.ui.view">
        <field name="name">social.lite.account.list</field>
        <field name="model">social.lite.account</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="platform"/><field name="active"/></list>
        </field>
    </record>

    <record id="action_social_lite_post" model="ir.actions.act_window">
        <field name="name">Posts</field>
        <field name="res_model">social.lite.post</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_social_lite_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">social.lite.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_social_lite_root" name="Social Marketing"
              web_icon="mail,static/description/icon.png" sequence="108"/>
    <menuitem id="menu_social_lite_posts" name="Posts"
              parent="menu_social_lite_root" action="action_social_lite_post" sequence="10"/>
    <menuitem id="menu_social_lite_config" name="Configuration"
              parent="menu_social_lite_root" sequence="90"/>
    <menuitem id="menu_social_lite_accounts" name="Accounts"
              parent="menu_social_lite_config" action="action_social_lite_account" sequence="10"/>

</odoo>
