<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_lite_board_form" model="ir.ui.view">
        <field name="name">subscription.lite.board.form</field>
        <field name="model">subscription.lite.board</field>
        <field name="arch" type="xml">
            <form string="Subscriptions Dashboard" create="false" edit="false">
                <field name="currency_id" invisible="1"/>
                <div class="cp_dash">
                    <div class="cp_hero d-flex justify-content-between align-items-center">
                        <div>
                            <p class="cp_hero_title">Subscriptions</p>
                            <span class="cp_hero_sub">Recurring revenue overview</span>
                        </div>
                        <div class="cp_hero_metric">
                            <div class="v"><field name="mrr"/></div>
                            <div class="l">Monthly Recurring Revenue</div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <div class="cp_card cp-success"><div class="cp_card_body">
                                <div class="cp_icon"><i class="fa fa-line-chart" title="ARR"/></div>
                                <div class="cp_label">Annual Run-Rate</div>
                                <div class="cp_value"><field name="arr"/></div>
                                <button name="action_mrr_log" type="object" class="cp_link">MRR evolution →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="cp_card cp-primary"><div class="cp_card_body">
                                <div class="cp_icon"><i class="fa fa-refresh" title="Active"/></div>
                                <div class="cp_label">Active</div>
                                <div class="cp_value"><field name="active_count"/></div>
                                <button name="action_active" type="object" class="cp_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="cp_card cp-info"><div class="cp_card_body">
                                <div class="cp_icon"><i class="fa fa-user" title="ARPU"/></div>
                                <div class="cp_label">ARPU</div>
                                <div class="cp_value"><field name="arpu"/></div>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="cp_card cp-warning"><div class="cp_card_body">
                                <div class="cp_icon"><i class="fa fa-clock-o" title="Due"/></div>
                                <div class="cp_label">Due for Invoicing</div>
                                <div class="cp_value"><field name="due_invoicing"/></div>
                                <button name="action_due" type="object" class="cp_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="cp_card cp-slate"><div class="cp_card_body">
                                <div class="cp_icon"><i class="fa fa-pencil" title="Draft"/></div>
                                <div class="cp_label">Draft</div>
                                <div class="cp_value"><field name="draft"/></div>
                                <button name="action_draft" type="object" class="cp_link">View →</button>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="cp_card cp-slate"><div class="cp_card_body">
                                <div class="cp_icon"><i class="fa fa-pause" title="Paused"/></div>
                                <div class="cp_label">Paused</div>
                                <div class="cp_value"><field name="paused"/></div>
                            </div></div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="cp_card cp-danger"><div class="cp_card_body">
                                <div class="cp_icon"><i class="fa fa-times-circle" title="Churned"/></div>
                                <div class="cp_label">Churned</div>
                                <div class="cp_value"><field name="churned"/></div>
                                <button name="action_churned" type="object" class="cp_link">View →</button>
                            </div></div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button name="action_refresh" type="object" string="Refresh"
                                class="btn btn-primary btn-sm" icon="fa-refresh"/>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="action_subscription_lite_board" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">subscription.lite.board</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_subscription_lite_dashboard" name="Dashboard"
              parent="menu_subscription_lite_root"
              action="action_subscription_lite_board" sequence="1"/>

</odoo>
