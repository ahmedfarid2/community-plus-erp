<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_lite_plan_list" model="ir.ui.view">
        <field name="name">subscription.lite.plan.list</field>
        <field name="model">subscription.lite.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="interval_number"/>
                <field name="interval_unit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_lite_plan_form" model="ir.ui.view">
        <field name="name">subscription.lite.plan.form</field>
        <field name="model">subscription.lite.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="interval_number"/>
                        <field name="interval_unit"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_lite_contract_list" model="ir.ui.view">
        <field name="name">subscription.lite.contract.list</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="plan_id"/>
                <field name="next_invoice_date"/>
                <field name="mrr" sum="Total MRR"/>
                <field name="invoice_count"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_lite_contract_form" model="ir.ui.view">
        <field name="name">subscription.lite.contract.form</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_create_upsell" type="object" string="Upsell" invisible="state != 'active'"/>
                    <button name="action_pause" type="object" string="Pause" invisible="state != 'active'"/>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <button name="action_reset" type="object" string="Reset" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="template_id"/>
                            <field name="plan_id"/>
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="start_date"/>
                            <field name="next_invoice_date"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="user_id"/>
                            <field name="auto_post"/>
                            <field name="close_reason_id" invisible="state != 'closed'"/>
                            <field name="recurring_total"/>
                            <field name="mrr"/>
                            <field name="invoice_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="account_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_subscription_lite_contract_kanban" model="ir.ui.view">
        <field name="name">subscription.lite.contract.kanban</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <field name="mrr"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="partner_id"/></div>
                                <div class="text-muted"><field name="plan_id"/></div>
                                <div class="mt-1">
                                    MRR: <field name="mrr" widget="monetary"/>
                                    <span class="float-end"><field name="user_id"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_subscription_lite_contract_graph" model="ir.ui.view">
        <field name="name">subscription.lite.contract.graph</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <graph string="MRR" type="bar">
                <field name="plan_id"/>
                <field name="mrr" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_lite_contract_pivot" model="ir.ui.view">
        <field name="name">subscription.lite.contract.pivot</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <pivot string="MRR Analysis">
                <field name="state" type="col"/>
                <field name="plan_id" type="row"/>
                <field name="mrr" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_subscription_lite_contract" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.lite.contract</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
    </record>

    <record id="action_subscription_lite_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">subscription.lite.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_subscription_lite_root" name="Subscriptions" sequence="48"/>
    <!-- Top-bar dropdowns mirror Enterprise: Subscriptions / Products / Reporting / Configuration -->
    <menuitem id="menu_subscription_lite_sub" name="Subscriptions" parent="menu_subscription_lite_root" sequence="10"/>
    <menuitem id="menu_subscription_lite_contract" name="Subscriptions" parent="menu_subscription_lite_sub" action="action_subscription_lite_contract" sequence="10"/>
    <menuitem id="menu_subscription_lite_config" name="Configuration" parent="menu_subscription_lite_root" sequence="90"/>
    <menuitem id="menu_subscription_lite_plan" name="Recurring Plans" parent="menu_subscription_lite_config" action="action_subscription_lite_plan" sequence="10"/>
</odoo>
