<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_lite_plan_list" model="ir.ui.view">
        <field name="name">subscription.lite.plan.list</field>
        <field name="model">subscription.lite.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="interval_number"/>
                <field name="interval_unit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_lite_plan_form" model="ir.ui.view">
        <field name="name">subscription.lite.plan.form</field>
        <field name="model">subscription.lite.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="interval_number"/>
                        <field name="interval_unit"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_lite_contract_list" model="ir.ui.view">
        <field name="name">subscription.lite.contract.list</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="next_invoice_date"/>
                <field name="mrr" sum="Total MRR"/>
                <field name="invoice_count"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_lite_contract_form" model="ir.ui.view">
        <field name="name">subscription.lite.contract.form</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_pause" type="object" string="Pause" invisible="state != 'active'"/>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <button name="action_reset" type="object" string="Reset" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                            <field name="start_date"/>
                            <field name="next_invoice_date"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="auto_post"/>
                            <field name="recurring_total"/>
                            <field name="mrr"/>
                            <field name="invoice_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="account_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_subscription_lite_contract" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.lite.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_subscription_lite_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">subscription.lite.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_subscription_lite_root" name="Subscriptions" sequence="48"/>
    <menuitem id="menu_subscription_lite_contract" name="Subscriptions" parent="menu_subscription_lite_root" action="action_subscription_lite_contract" sequence="10"/>
    <menuitem id="menu_subscription_lite_plan" name="Plans" parent="menu_subscription_lite_root" action="action_subscription_lite_plan" sequence="20"/>
</odoo>
