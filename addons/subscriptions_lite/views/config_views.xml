<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Close Reasons (churn reasons) ===== -->
    <record id="view_close_reason_list" model="ir.ui.view">
        <field name="name">subscription.lite.close.reason.list</field>
        <field name="model">subscription.lite.close.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_close_reason" model="ir.actions.act_window">
        <field name="name">Close Reasons</field>
        <field name="res_model">subscription.lite.close.reason</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_close_reason" name="Close Reasons"
              parent="menu_subscription_lite_config"
              action="action_close_reason" sequence="20"/>

    <!-- ===== To Renew (active, due to invoice) ===== -->
    <record id="action_subscription_to_renew" model="ir.actions.act_window">
        <field name="name">To Renew</field>
        <field name="res_model">subscription.lite.contract</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state','=','active'),('next_invoice_date','&lt;=',context_today().strftime('%Y-%m-%d'))]</field>
    </record>

    <menuitem id="menu_subscription_to_renew" name="To Renew"
              parent="menu_subscription_lite_root"
              action="action_subscription_to_renew" sequence="15"/>

    <!-- ===== Customers (subscriptions grouped by customer) ===== -->
    <record id="action_subscription_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">subscription.lite.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>

    <record id="view_subscription_search" model="ir.ui.view">
        <field name="name">subscription.lite.contract.search</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="group_partner" string="Customer"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_user" string="Salesperson"
                        context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_subscription_customers" name="Customers"
              parent="menu_subscription_lite_root"
              action="action_subscription_customers" sequence="20"/>

</odoo>
