<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Quotations (draft subscriptions) ===== -->
    <record id="action_subscription_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">subscription.lite.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','draft')]</field>
    </record>
    <menuitem id="menu_subscription_quotations" name="Quotations"
              parent="menu_subscription_lite_root"
              action="action_subscription_quotations" sequence="12"/>

    <!-- ===== Upsells ===== -->
    <record id="action_subscription_upsells" model="ir.actions.act_window">
        <field name="name">Upsells</field>
        <field name="res_model">subscription.lite.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_upsell','=',True)]</field>
    </record>
    <menuitem id="menu_subscription_upsells" name="Upsells"
              parent="menu_subscription_lite_root"
              action="action_subscription_upsells" sequence="18"/>

    <!-- ===== Retention (cohort pivot by activation month) ===== -->
    <record id="view_subscription_retention_pivot" model="ir.ui.view">
        <field name="name">subscription.lite.contract.retention.pivot</field>
        <field name="model">subscription.lite.contract</field>
        <field name="arch" type="xml">
            <pivot string="Retention">
                <field name="activated_date" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="mrr" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_subscription_retention" model="ir.actions.act_window">
        <field name="name">Retention</field>
        <field name="res_model">subscription.lite.contract</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_subscription_retention_pivot"/>
        <field name="domain">[('activated_date','!=',False)]</field>
    </record>
    <menuitem id="menu_subscription_retention" name="Retention"
              parent="menu_subscription_lite_reporting"
              action="action_subscription_retention" sequence="20"/>

    <!-- ===== Quotation Templates ===== -->
    <record id="view_subscription_template_list" model="ir.ui.view">
        <field name="name">subscription.lite.template.list</field>
        <field name="model">subscription.lite.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_subscription_template_form" model="ir.ui.view">
        <field name="name">subscription.lite.template.form</field>
        <field name="model">subscription.lite.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="plan_id"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                        </list>
                    </field>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_subscription_template" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">subscription.lite.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_subscription_template" name="Quotation Templates"
              parent="menu_subscription_lite_config"
              action="action_subscription_template" sequence="15"/>

    <!-- ===== Products submenu (native actions) ===== -->
    <menuitem id="menu_subscription_products_root" name="Products"
              parent="menu_subscription_lite_root" sequence="40"/>
    <menuitem id="menu_subscription_products" name="Products"
              parent="menu_subscription_products_root"
              action="product.product_template_action" sequence="10"/>
    <menuitem id="menu_subscription_pricelists" name="Pricelists"
              parent="menu_subscription_products_root"
              action="product.product_pricelist_action2" sequence="20"/>

    <!-- ===== Native config: Activity Types / Plans ===== -->
    <menuitem id="menu_subscription_activity_types" name="Activity Types"
              parent="menu_subscription_lite_config"
              action="mail.mail_activity_type_action" sequence="30"/>
    <menuitem id="menu_subscription_activity_plans" name="Activity Plans"
              parent="menu_subscription_lite_config"
              action="mail.mail_activity_plan_action" sequence="40"/>

</odoo>
