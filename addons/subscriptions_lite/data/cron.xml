<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_subscription_due_invoices" model="ir.cron">
            <field name="name">Subscriptions: generate due invoices</field>
            <field name="model_id" ref="model_subscription_lite_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_due_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_subscription_mrr_snapshot" model="ir.cron">
            <field name="name">Subscriptions: monthly MRR snapshot</field>
            <field name="model_id" ref="model_subscription_lite_mrr_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_snapshot_mrr()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
