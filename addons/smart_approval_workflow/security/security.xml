<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_approval" model="ir.module.category">
        <field name="name">Approvals</field>
        <field name="description">Configurable approval workflows.</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_approval" model="res.groups.privilege">
        <field name="name">Approvals</field>
        <field name="category_id" ref="module_category_approval"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="comment">Create approval requests and act on requests assigned to them.</field>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        <field name="comment">View and act on all approval requests.</field>
    </record>

    <record id="group_approval_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="comment">Configure workflows and approval steps; full access.</field>
    </record>

    <!-- ============================ Record Rules ============================ -->

    <!-- Requests: user sees own + those they are an approver on -->
    <record id="rule_request_user" model="ir.rule">
        <field name="name">Approval Request: own or assigned to me</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('approval_line_ids.approver_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_request_manager" model="ir.rule">
        <field name="name">Approval Request: managers see all</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Request lines follow the same logic -->
    <record id="rule_request_line_user" model="ir.rule">
        <field name="name">Approval Line: own or assigned to me</field>
        <field name="model_id" ref="model_approval_request_line"/>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('approver_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_request_line_manager" model="ir.rule">
        <field name="name">Approval Line: managers see all</field>
        <field name="model_id" ref="model_approval_request_line"/>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
