<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fsm_lite_order_kanban" model="ir.ui.view">
        <field name="name">fsm.lite.order.kanban</field>
        <field name="model">fsm.lite.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="partner_id"/></div>
                                <div><field name="employee_id"/></div>
                                <div><field name="scheduled_date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_fsm_lite_order_list" model="ir.ui.view">
        <field name="name">fsm.lite.order.list</field>
        <field name="model">fsm.lite.order</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="scheduled_date"/>
                <field name="duration"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fsm_lite_order_calendar" model="ir.ui.view">
        <field name="name">fsm.lite.order.calendar</field>
        <field name="model">fsm.lite.order</field>
        <field name="arch" type="xml">
            <calendar string="Field Service" date_start="scheduled_date"
                      color="employee_id" mode="month">
                <field name="partner_id"/>
                <field name="employee_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_fsm_lite_order_form" model="ir.ui.view">
        <field name="name">fsm.lite.order.form</field>
        <field name="model">fsm.lite.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" type="object" string="Plan"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="address"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="duration"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Worksheet">
                            <field name="worksheet"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fsm_lite_order" model="ir.actions.act_window">
        <field name="name">Field Service Orders</field>
        <field name="res_model">fsm.lite.order</field>
        <field name="view_mode">kanban,list,calendar,form</field>
    </record>

    <menuitem id="menu_fsm_lite_root" name="Field Service"
              web_icon="field_service_lite,static/description/icon.png" sequence="99"/>
    <menuitem id="menu_fsm_lite_orders" name="Orders"
              parent="menu_fsm_lite_root" action="action_fsm_lite_order" sequence="10"/>

</odoo>
