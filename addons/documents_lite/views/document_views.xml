<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_documents_lite_folder_list" model="ir.ui.view">
        <field name="name">documents.lite.folder.list</field>
        <field name="model">documents.lite.folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_documents_lite_folder_form" model="ir.ui.view">
        <field name="name">documents.lite.folder.form</field>
        <field name="model">documents.lite.folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_documents_lite_document_list" model="ir.ui.view">
        <field name="name">documents.lite.document.list</field>
        <field name="model">documents.lite.document</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'archived'"
                  decoration-warning="expiry_state == 'expiring'"
                  decoration-danger="expiry_state == 'expired'">
                <field name="name"/>
                <field name="folder_id"/>
                <field name="owner_id"/>
                <field name="partner_id"/>
                <field name="tag"/>
                <field name="expiry_date"/>
                <field name="expiry_state" widget="badge"
                       decoration-success="expiry_state == 'valid'"
                       decoration-warning="expiry_state == 'expiring'"
                       decoration-danger="expiry_state == 'expired'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_documents_lite_document_form" model="ir.ui.view">
        <field name="name">documents.lite.document.form</field>
        <field name="model">documents.lite.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_archive_document" type="object" string="Archive" invisible="state == 'archived'"/>
                    <button name="action_activate_document" type="object" string="Activate" class="btn-primary" invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="folder_id"/>
                            <field name="owner_id"/>
                            <field name="partner_id"/>
                            <field name="tag"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="expiry_date"/>
                            <field name="expiry_state"/>
                            <field name="filename" invisible="1"/>
                            <field name="document" filename="filename"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_documents_lite_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">documents.lite.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_documents_lite_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">documents.lite.folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_documents_lite_root" name="Documents" sequence="47"/>
    <menuitem id="menu_documents_lite_document" name="Documents" parent="menu_documents_lite_root" action="action_documents_lite_document" sequence="10"/>
    <menuitem id="menu_documents_lite_folder" name="Folders" parent="menu_documents_lite_root" action="action_documents_lite_folder" sequence="20"/>
</odoo>
