<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Control Points -->
    <record id="view_quality_lite_point_list" model="ir.ui.view">
        <field name="name">quality.lite.point.list</field>
        <field name="model">quality.lite.point</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="test_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_quality_lite_point_form" model="ir.ui.view">
        <field name="name">quality.lite.point.form</field>
        <field name="model">quality.lite.point</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="test_type"/>
                        </group>
                        <group>
                            <field name="norm_min" invisible="test_type != 'measure'"/>
                            <field name="norm_max" invisible="test_type != 'measure'"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Inspection instructions..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_quality_lite_point" model="ir.actions.act_window">
        <field name="name">Control Points</field>
        <field name="res_model">quality.lite.point</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Checks -->
    <record id="view_quality_lite_check_kanban" model="ir.ui.view">
        <field name="name">quality.lite.check.kanban</field>
        <field name="model">quality.lite.check</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="point_id"/></strong>
                                <div class="text-muted"><field name="product_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_quality_lite_check_list" model="ir.ui.view">
        <field name="name">quality.lite.check.list</field>
        <field name="model">quality.lite.check</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'pass'" decoration-danger="state == 'fail'">
                <field name="point_id"/>
                <field name="product_id"/>
                <field name="test_type"/>
                <field name="measure"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_quality_lite_check_form" model="ir.ui.view">
        <field name="name">quality.lite.check.form</field>
        <field name="model">quality.lite.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pass" type="object" string="Pass"
                            class="btn-success" invisible="state != 'todo' or test_type == 'measure'"/>
                    <button name="action_fail" type="object" string="Fail"
                            class="btn-danger" invisible="state != 'todo' or test_type == 'measure'"/>
                    <button name="action_measure_check" type="object" string="Validate Measure"
                            class="btn-primary" invisible="test_type != 'measure'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="point_id"/>
                            <field name="product_id"/>
                            <field name="picking_id"/>
                        </group>
                        <group>
                            <field name="test_type"/>
                            <field name="measure" invisible="test_type != 'measure'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_quality_lite_check" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">quality.lite.check</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_quality_lite_root" name="Quality"
              web_icon="quality_lite,static/description/icon.png" sequence="101"/>
    <menuitem id="menu_quality_lite_checks" name="Quality Checks"
              parent="menu_quality_lite_root" action="action_quality_lite_check" sequence="10"/>
    <menuitem id="menu_quality_lite_config" name="Configuration"
              parent="menu_quality_lite_root" sequence="90"/>
    <menuitem id="menu_quality_lite_points" name="Control Points"
              parent="menu_quality_lite_config" action="action_quality_lite_point" sequence="10"/>

</odoo>
