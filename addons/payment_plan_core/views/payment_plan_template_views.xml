<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_plan_template_list" model="ir.ui.view">
        <field name="name">payment.plan.template.list</field>
        <field name="model">payment.plan.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="number_of_payments"/>
                <field name="frequency"/>
                <field name="first_payment_percent"/>
                <field name="equal_distribution"/>
                <field name="grace_period_days"/>
            </list>
        </field>
    </record>

    <record id="view_payment_plan_template_form" model="ir.ui.view">
        <field name="name">payment.plan.template.form</field>
        <field name="model">payment.plan.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. 3 Monthly Payments"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="number_of_payments"/>
                            <field name="frequency"/>
                            <field name="grace_period_days"/>
                        </group>
                        <group>
                            <field name="equal_distribution"/>
                            <field name="first_payment_percent"
                                   invisible="equal_distribution"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Generation uses the plan's Total Amount and Start Date.
                        With Equal Distribution off, the First Payment % is taken
                        on the first line and the rest is split over the others.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payment_plan_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">payment.plan.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
