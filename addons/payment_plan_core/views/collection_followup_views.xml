<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_collection_followup_list" model="ir.ui.view">
        <field name="name">collection.followup.list</field>
        <field name="model">collection.followup</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'done'"
                  decoration-muted="status == 'cancelled'">
                <field name="followup_date"/>
                <field name="partner_id"/>
                <field name="plan_id" optional="show"/>
                <field name="followup_type"/>
                <field name="assigned_to"/>
                <field name="next_action_date" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_collection_followup_form" model="ir.ui.view">
        <field name="name">collection.followup.form</field>
        <field name="model">collection.followup</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object"
                            string="Mark Done" class="btn-primary"
                            invisible="status != 'planned'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status == 'cancelled'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                            <field name="line_id"
                                   domain="[('plan_id','=',plan_id)]"/>
                        </group>
                        <group>
                            <field name="followup_type"/>
                            <field name="followup_date"/>
                            <field name="assigned_to"/>
                            <field name="next_action_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="What was discussed / agreed…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_collection_followup_search" model="ir.ui.view">
        <field name="name">collection.followup.search</field>
        <field name="model">collection.followup</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="assigned_to"/>
                <filter name="planned" string="Planned"
                        domain="[('status','=','planned')]"/>
                <filter name="done" string="Done"
                        domain="[('status','=','done')]"/>
                <separator/>
                <filter name="my_followups" string="My Follow-ups"
                        domain="[('assigned_to','=',uid)]"/>
                <separator/>
                <filter name="group_status" string="Status"
                        context="{'group_by':'status'}"/>
                <filter name="group_type" string="Type"
                        context="{'group_by':'followup_type'}"/>
                <filter name="group_assigned" string="Assigned To"
                        context="{'group_by':'assigned_to'}"/>
                <filter name="group_partner" string="Customer"
                        context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_collection_followup" model="ir.actions.act_window">
        <field name="name">Follow-ups</field>
        <field name="res_model">collection.followup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_collection_followup_search"/>
        <field name="context">{'search_default_planned': 1}</field>
    </record>

</odoo>
