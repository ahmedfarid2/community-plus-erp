<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_plan_type_list" model="ir.ui.view">
        <field name="name">payment.plan.type.list</field>
        <field name="model">payment.plan.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_payment_plan_type_form" model="ir.ui.view">
        <field name="name">payment.plan.type.form</field>
        <field name="model">payment.plan.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Installments"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payment_plan_type_search" model="ir.ui.view">
        <field name="name">payment.plan.type.search</field>
        <field name="model">payment.plan.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived"
                        domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_payment_plan_type" model="ir.actions.act_window">
        <field name="name">Plan Types</field>
        <field name="res_model">payment.plan.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_payment_plan_type_search"/>
    </record>

</odoo>
