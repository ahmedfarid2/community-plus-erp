<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appointment Types -->
    <record id="view_appointment_lite_type_list" model="ir.ui.view">
        <field name="name">appointment.lite.type.list</field>
        <field name="model">appointment.lite.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="duration"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_appointment_lite_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">appointment.lite.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Bookings -->
    <record id="view_appointment_lite_booking_calendar" model="ir.ui.view">
        <field name="name">appointment.lite.booking.calendar</field>
        <field name="model">appointment.lite.booking</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start_datetime"
                      date_stop="stop_datetime" color="user_id" mode="week">
                <field name="partner_id"/>
                <field name="appointment_type_id"/>
            </calendar>
        </field>
    </record>
    <record id="view_appointment_lite_booking_list" model="ir.ui.view">
        <field name="name">appointment.lite.booking.list</field>
        <field name="model">appointment.lite.booking</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="appointment_type_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="start_datetime"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_appointment_lite_booking_form" model="ir.ui.view">
        <field name="name">appointment.lite.booking.form</field>
        <field name="model">appointment.lite.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'booked'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="appointment_type_id"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="stop_datetime"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_appointment_lite_booking" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">appointment.lite.booking</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <menuitem id="menu_appointment_lite_root" name="Appointments"
              web_icon="mail,static/description/icon.png" sequence="100"/>
    <menuitem id="menu_appointment_lite_bookings" name="Appointments"
              parent="menu_appointment_lite_root" action="action_appointment_lite_booking"
              sequence="10"/>
    <menuitem id="menu_appointment_lite_config" name="Configuration"
              parent="menu_appointment_lite_root" sequence="90"/>
    <menuitem id="menu_appointment_lite_types" name="Appointment Types"
              parent="menu_appointment_lite_config" action="action_appointment_lite_type"
              sequence="10"/>

</odoo>
