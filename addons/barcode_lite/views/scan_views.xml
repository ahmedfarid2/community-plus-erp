<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_barcode_lite_session_form" model="ir.ui.view">
        <field name="name">barcode.lite.session.form</field>
        <field name="model">barcode.lite.session</field>
        <field name="arch" type="xml">
            <form string="Barcode Scanning">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="location_id"/>
                        <field name="scan_input" placeholder="Scan a barcode..."
                               widget="char"/>
                        <field name="total_qty"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" decoration-danger="not_found">
                            <field name="barcode"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="not_found" string="Unknown"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_barcode_lite_session_list" model="ir.ui.view">
        <field name="name">barcode.lite.session.list</field>
        <field name="model">barcode.lite.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location_id"/>
                <field name="total_qty"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_barcode_lite_session" model="ir.actions.act_window">
        <field name="name">Barcode Scanning</field>
        <field name="res_model">barcode.lite.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_barcode_lite_root" name="Barcode"
              web_icon="barcode_lite,static/description/icon.png" sequence="103"/>
    <menuitem id="menu_barcode_lite_scan" name="Scan"
              parent="menu_barcode_lite_root" action="action_barcode_lite_session"
              sequence="10"/>

</odoo>
