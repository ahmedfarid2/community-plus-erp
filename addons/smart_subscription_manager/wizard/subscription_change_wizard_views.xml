<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_change_wizard_form" model="ir.ui.view">
        <field name="name">subscription.change.wizard.form</field>
        <field name="model">subscription.change.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="subscription_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <field name="new_plan_id"/>
                    <field name="new_price"/>
                    <field name="effective_date"/>
                    <field name="proration_policy"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Apply Change" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
