<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_subscription" model="ir.module.category">
        <field name="name">Subscriptions</field>
        <field name="description">Subscription &amp; recurring revenue management.</field>
        <field name="sequence">27</field>
    </record>

    <record id="privilege_subscription" model="res.groups.privilege">
        <field name="name">Subscriptions</field>
        <field name="category_id" ref="module_category_subscription"/>
        <field name="sequence">27</field>
    </record>

    <record id="group_subscription_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_subscription"/>
        <field name="comment">Create and manage their own subscriptions; read active plans.</field>
    </record>

    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_subscription"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
        <field name="comment">View all subscriptions, billing lines and metrics.</field>
    </record>

    <record id="group_subscription_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_subscription"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_manager'))]"/>
        <field name="comment">Configure plans, cancellation reasons and settings.</field>
    </record>

    <!-- ============================ Record Rules ============================ -->
    <record id="rule_subscription_user" model="ir.rule">
        <field name="name">Subscription: own</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="groups" eval="[(4, ref('group_subscription_user'))]"/>
        <field name="domain_force">['|', ('responsible_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_subscription_manager" model="ir.rule">
        <field name="name">Subscription: managers see all</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="groups" eval="[(4, ref('group_subscription_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
