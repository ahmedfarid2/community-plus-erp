<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_list" model="ir.ui.view">
        <field name="name">subscription.lifecycle.event.list</field>
        <field name="model">subscription.lifecycle.event</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="event_date"/>
                <field name="subscription_id"/>
                <field name="partner_id" optional="show"/>
                <field name="event_type"/>
                <field name="user_id"/>
                <field name="old_plan_id" optional="hide"/>
                <field name="new_plan_id" optional="hide"/>
                <field name="reason" optional="hide"/>
                <field name="notes"/>
            </list>
        </field>
    </record>
    <record id="view_event_search" model="ir.ui.view">
        <field name="name">subscription.lifecycle.event.search</field>
        <field name="model">subscription.lifecycle.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <filter name="group_type" string="Event" context="{'group_by':'event_type'}"/>
                <filter name="group_sub" string="Subscription" context="{'group_by':'subscription_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_event" model="ir.actions.act_window">
        <field name="name">Lifecycle Events</field>
        <field name="res_model">subscription.lifecycle.event</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_event_search"/>
    </record>
</odoo>
