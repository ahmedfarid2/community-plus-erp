<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_billing_list" model="ir.ui.view">
        <field name="name">subscription.billing.line.list</field>
        <field name="model">subscription.billing.line</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'overdue'"
                  decoration-success="state == 'paid'"
                  decoration-muted="state in ('skipped','cancelled')"
                  editable="bottom">
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="period_start_date"/>
                <field name="due_date"/>
                <field name="total_amount" sum="Total"/>
                <field name="paid_amount" sum="Paid"/>
                <field name="remaining_amount" sum="Remaining"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_mark_paid" type="object" icon="fa-check"
                        title="Mark paid" invisible="state in ('paid','cancelled','skipped')"/>
            </list>
        </field>
    </record>

    <record id="view_billing_form" model="ir.ui.view">
        <field name="name">subscription.billing.line.form</field>
        <field name="model">subscription.billing.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid" type="object" string="Mark as Paid"
                            class="btn-primary" invisible="state in ('paid','cancelled','skipped')"/>
                    <button name="action_mark_partial" type="object" string="Mark Partially Paid"
                            invisible="state in ('paid','cancelled','skipped')"/>
                    <button name="action_mark_skipped" type="object" string="Skip"
                            invisible="state in ('paid','cancelled','skipped')"/>
                    <button name="action_mark_cancelled" type="object" string="Cancel"
                            invisible="state in ('cancelled',)"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="period_start_date"/>
                            <field name="period_end_date"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="discount_amount"/>
                            <field name="tax_amount"/>
                            <field name="total_amount"/>
                            <field name="paid_amount"/>
                            <field name="remaining_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_billing_search" model="ir.ui.view">
        <field name="name">subscription.billing.line.search</field>
        <field name="model">subscription.billing.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <filter name="overdue" string="Overdue" domain="[('state','=','overdue')]"/>
                <filter name="unpaid" string="Unpaid" domain="[('state','in',('due','partially_paid','overdue'))]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <separator/>
                <filter name="due_today" string="Due Today"
                        domain="[('due_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="due_week" string="Due This Week"
                        domain="[('due_date','&gt;=', context_today().strftime('%Y-%m-%d')), ('due_date','&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_sub" string="Subscription" context="{'group_by':'subscription_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                <filter name="group_due" string="Due Date" context="{'group_by':'due_date'}"/>
            </search>
        </field>
    </record>

    <record id="view_billing_graph" model="ir.ui.view">
        <field name="name">subscription.billing.line.graph</field>
        <field name="model">subscription.billing.line</field>
        <field name="arch" type="xml">
            <graph string="Billing" type="bar">
                <field name="due_date" interval="month"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_billing" model="ir.actions.act_window">
        <field name="name">Billing Lines</field>
        <field name="res_model">subscription.billing.line</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_billing_search"/>
    </record>

    <record id="action_billing_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Billing</field>
        <field name="res_model">subscription.billing.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','overdue')]</field>
        <field name="search_view_id" ref="view_billing_search"/>
    </record>

</odoo>
