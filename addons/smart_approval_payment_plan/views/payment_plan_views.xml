<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_plan_form_approval" model="ir.ui.view">
        <field name="name">payment.plan.form.approval</field>
        <field name="model">payment.plan</field>
        <field name="inherit_id" ref="payment_plan_core.view_payment_plan_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_discount_approval" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        invisible="not approval_request_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Discount</span>
                        <span class="o_stat_text">Approval</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="before">
                <group string="Discount / Waiver"
                       invisible="state in ('draft','cancelled')">
                    <field name="approval_request_id" invisible="1"/>
                    <group>
                        <field name="discount_amount"/>
                        <field name="discount_reason"/>
                        <field name="discount_applied"/>
                    </group>
                    <group>
                        <field name="approval_state" widget="badge"
                               invisible="approval_state == 'none'"
                               decoration-info="approval_state == 'pending'"
                               decoration-success="approval_state == 'approved'"
                               decoration-danger="approval_state == 'rejected'"
                               decoration-warning="approval_state == 'to_request'"/>
                        <button name="action_apply_discount" type="object"
                                string="Apply Discount / Waiver"
                                class="btn-primary"
                                invisible="discount_amount &lt;= 0"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
