<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ocr_lite_document_form" model="ir.ui.view">
        <field name="name">ocr.lite.document.form</field>
        <field name="model">ocr.lite.document</field>
        <field name="arch" type="xml">
            <form string="Invoice OCR">
                <header>
                    <button name="action_extract" type="object" string="Scan (OCR)"
                            class="btn-primary" invisible="state == 'billed'"/>
                    <button name="action_create_bill" type="object" string="Create Vendor Bill"
                            class="btn-primary" invisible="state != 'scanned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="document" filename="filename"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="partner_name" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extracted Text">
                            <field name="extracted_text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ocr_lite_document_list" model="ir.ui.view">
        <field name="name">ocr.lite.document.list</field>
        <field name="model">ocr.lite.document</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'billed'">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="amount"/>
                <field name="invoice_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_ocr_lite_document" model="ir.actions.act_window">
        <field name="name">Invoice OCR</field>
        <field name="res_model">ocr.lite.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ocr_lite_root" name="Invoice OCR"
              web_icon="ocr_lite,static/description/icon.png" sequence="104"/>
    <menuitem id="menu_ocr_lite_docs" name="Documents"
              parent="menu_ocr_lite_root" action="action_ocr_lite_document" sequence="10"/>

</odoo>
