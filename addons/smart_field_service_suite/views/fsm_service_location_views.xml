<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_list" model="ir.ui.view">
        <field name="name">fsm.service.location.list</field><field name="model">fsm.service.location</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="partner_id"/><field name="city"/><field name="contact_name"/><field name="contact_phone"/></list>
        </field>
    </record>
    <record id="view_location_form" model="ir.ui.view">
        <field name="name">fsm.service.location.form</field><field name="model">fsm.service.location</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group>
                    <field name="partner_id"/><field name="address"/><field name="city"/><field name="state_id"/><field name="country_id"/>
                </group><group>
                    <field name="contact_name"/><field name="contact_phone"/><field name="latitude"/><field name="longitude"/><field name="active"/>
                </group></group>
                <group string="Access Instructions"><field name="access_instructions" nolabel="1"/></group>
            </sheet></form>
        </field>
    </record>
    <record id="view_location_search" model="ir.ui.view">
        <field name="name">fsm.service.location.search</field><field name="model">fsm.service.location</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="partner_id"/><field name="city"/>
                <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_location" model="ir.actions.act_window">
        <field name="name">Customers &amp; Locations</field><field name="res_model">fsm.service.location</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_location_search"/>
    </record>
</odoo>
