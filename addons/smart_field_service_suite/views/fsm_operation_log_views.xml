<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_log_list" model="ir.ui.view">
        <field name="name">fsm.operation.log.list</field><field name="model">fsm.operation.log</field>
        <field name="arch" type="xml">
            <list create="false"><field name="event_date"/><field name="work_order_id"/><field name="partner_id"/>
                <field name="event_type"/><field name="user_id"/><field name="description"/></list>
        </field>
    </record>
    <record id="view_log_search" model="ir.ui.view">
        <field name="name">fsm.operation.log.search</field><field name="model">fsm.operation.log</field>
        <field name="arch" type="xml">
            <search><field name="work_order_id"/><field name="partner_id"/>
                <filter name="group_event" string="Event" context="{'group_by':'event_type'}"/>
                <filter name="group_wo" string="Work Order" context="{'group_by':'work_order_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_log" model="ir.actions.act_window">
        <field name="name">Operation Logs</field><field name="res_model">fsm.operation.log</field><field name="view_mode">list</field>
        <field name="search_view_id" ref="view_log_search"/>
    </record>
</odoo>
