<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_team_list" model="ir.ui.view">
        <field name="name">fsm.team.list</field><field name="model">fsm.team</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="manager_id"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>
    <record id="view_team_form" model="ir.ui.view">
        <field name="name">fsm.team.form</field><field name="model">fsm.team</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <group><field name="manager_id"/><field name="service_area_ids" widget="many2many_tags"/><field name="active"/></group>
                <field name="technician_ids"><list><field name="name"/><field name="phone"/><field name="availability_status"/></list></field>
            </sheet></form>
        </field>
    </record>
    <record id="action_team" model="ir.actions.act_window">
        <field name="name">Teams</field><field name="res_model">fsm.team</field><field name="view_mode">list,form</field>
    </record>
</odoo>
