<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_service_request" model="ir.sequence">
        <field name="name">FSM Service Request</field>
        <field name="code">fsm.service.request</field>
        <field name="prefix">SR/%(year)s/</field>
        <field name="padding">4</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_work_order" model="ir.sequence">
        <field name="name">FSM Work Order</field>
        <field name="code">fsm.work.order</field>
        <field name="prefix">WO/%(year)s/</field>
        <field name="padding">4</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_contract" model="ir.sequence">
        <field name="name">FSM Maintenance Contract</field>
        <field name="code">fsm.maintenance.contract</field>
        <field name="prefix">MC/%(year)s/</field>
        <field name="padding">4</field><field name="company_id" eval="False"/>
    </record>
</odoo>
