<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_referral_lite_kanban" model="ir.ui.view">
        <field name="name">hr.referral.lite.kanban</field>
        <field name="model">hr.referral.lite</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="job_id"/></div>
                                <div>Referred by <field name="referrer_id"/></div>
                                <div><field name="reward_points"/> pts</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_referral_lite_list" model="ir.ui.view">
        <field name="name">hr.referral.lite.list</field>
        <field name="model">hr.referral.lite</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'hired'" decoration-muted="state == 'refused'">
                <field name="name"/>
                <field name="job_id"/>
                <field name="referrer_id"/>
                <field name="reward_points"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_referral_lite_form" model="ir.ui.view">
        <field name="name">hr.referral.lite.form</field>
        <field name="model">hr.referral.lite</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_interview" type="object" string="To Interview"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_hire" type="object" string="Hire"
                            class="btn-primary" invisible="state not in ('new','interview')"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state in ('hired','refused')"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="referrer_id"/>
                            <field name="reward_points"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes about the candidate..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_referral_lite" model="ir.actions.act_window">
        <field name="name">Referrals</field>
        <field name="res_model">hr.referral.lite</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_referral_lite_root" name="Referrals"
              web_icon="referrals_lite,static/description/icon.png" sequence="97"/>
    <menuitem id="menu_referral_lite_main" name="Referrals"
              parent="menu_referral_lite_root" action="action_referral_lite" sequence="10"/>

</odoo>
