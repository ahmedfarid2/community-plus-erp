<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sign_lite_list" model="ir.ui.view">
        <field name="name">sign.lite.request.list</field>
        <field name="model">sign.lite.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'signed'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="signed_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_sign_lite_kanban" model="ir.ui.view">
        <field name="name">sign.lite.request.kanban</field>
        <field name="model">sign.lite.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="partner_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sign_lite_form" model="ir.ui.view">
        <field name="name">sign.lite.request.form</field>
        <field name="model">sign.lite.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send for Signature"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_sign" type="object" string="Sign"
                            class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('signed', 'cancel')"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="filename" invisible="1"/>
                            <field name="document" filename="filename"/>
                        </group>
                        <group>
                            <field name="signed_by" readonly="1"/>
                            <field name="signed_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Signature">
                        <field name="signature" widget="signature" nolabel="1"
                               readonly="state in ('signed', 'cancel')"/>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sign_lite" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">sign.lite.request</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_sign_lite_root" name="Sign"
              web_icon="sign_lite,static/description/icon.png" sequence="98"/>
    <menuitem id="menu_sign_lite_main" name="Requests"
              parent="menu_sign_lite_root" action="action_sign_lite" sequence="10"/>

</odoo>
