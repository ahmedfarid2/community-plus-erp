<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_afr_cashflow_form" model="ir.ui.view">
        <field name="name">afr.cashflow.form</field>
        <field name="model">afr.cashflow</field>
        <field name="arch" type="xml">
            <form string="Cash Flow Statement" create="false" edit="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="cp_dash">
                        <div class="cp_hero d-flex justify-content-between align-items-center">
                            <div>
                                <p class="cp_hero_title">Cash Flow Statement</p>
                                <span class="cp_hero_sub">Operating · Investing · Financing</span>
                            </div>
                            <div class="cp_hero_metric">
                                <div class="v"><field name="closing_balance"/></div>
                                <div class="l">Closing Cash</div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="cp_card cp-slate"><div class="cp_card_body">
                                    <div class="cp_icon"><i class="fa fa-flag-o" title="Opening"/></div>
                                    <div class="cp_label">Opening</div>
                                    <div class="cp_value"><field name="opening_balance"/></div>
                                </div></div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="cp_card cp-success"><div class="cp_card_body">
                                    <div class="cp_icon"><i class="fa fa-cogs" title="Operating"/></div>
                                    <div class="cp_label">Operating</div>
                                    <div class="cp_value"><field name="operating"/></div>
                                </div></div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="cp_card cp-warning"><div class="cp_card_body">
                                    <div class="cp_icon"><i class="fa fa-cube" title="Investing"/></div>
                                    <div class="cp_label">Investing</div>
                                    <div class="cp_value"><field name="investing"/></div>
                                </div></div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="cp_card cp-purple"><div class="cp_card_body">
                                    <div class="cp_icon"><i class="fa fa-bank" title="Financing"/></div>
                                    <div class="cp_label">Financing</div>
                                    <div class="cp_value"><field name="financing"/></div>
                                </div></div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="cp_card cp-primary"><div class="cp_card_body">
                                    <div class="cp_icon"><i class="fa fa-exchange" title="Net Change"/></div>
                                    <div class="cp_label">Net Change</div>
                                    <div class="cp_value"><field name="net_change"/></div>
                                </div></div>
                            </div>
                        </div>

                        <div class="d-flex align-items-end gap-3 mt-3">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </div>
                        <div class="text-muted small mt-2">
                            Cash &amp; bank movements classified by counterpart: fixed assets →
                            investing; equity / long-term liabilities → financing; else operating.
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_afr_cashflow" model="ir.actions.act_window">
        <field name="name">Cash Flow Statement</field>
        <field name="res_model">afr.cashflow</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_afr_cashflow" name="Cash Flow Statement"
              parent="account.menu_finance_reports" action="action_afr_cashflow"
              sequence="50"/>

</odoo>
