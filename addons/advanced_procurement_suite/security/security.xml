<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_procurement" model="ir.module.category">
        <field name="name">Procurement</field>
        <field name="description">Procurement &amp; vendor management.</field>
        <field name="sequence">29</field>
    </record>

    <record id="privilege_procurement" model="res.groups.privilege">
        <field name="name">Procurement</field>
        <field name="category_id" ref="module_category_procurement"/>
        <field name="sequence">29</field>
    </record>

    <record id="group_proc_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="comment">Create and view their own purchase requests.</field>
    </record>
    <record id="group_proc_buyer" model="res.groups">
        <field name="name">Buyer</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_proc_requester'))]"/>
        <field name="comment">Manage RFQ events, vendor quotes and awards.</field>
    </record>
    <record id="group_proc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_proc_buyer'))]"/>
        <field name="comment">Approve requests and awards; view reports and performance.</field>
    </record>
    <record id="group_proc_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_proc_manager'))]"/>
        <field name="comment">Configure categories, evaluation criteria and settings.</field>
    </record>

    <!-- Requesters: only their own requests -->
    <record id="rule_request_requester" model="ir.rule">
        <field name="name">Request: own</field>
        <field name="model_id" ref="model_procurement_request"/>
        <field name="groups" eval="[(4, ref('group_proc_requester'))]"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('responsible_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_request_buyer" model="ir.rule">
        <field name="name">Request: buyers and up see all</field>
        <field name="model_id" ref="model_procurement_request"/>
        <field name="groups" eval="[(4, ref('group_proc_buyer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
