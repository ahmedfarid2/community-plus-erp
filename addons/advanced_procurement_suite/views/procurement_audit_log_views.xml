<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_list" model="ir.ui.view">
        <field name="name">procurement.audit.log.list</field><field name="model">procurement.audit.log</field>
        <field name="arch" type="xml">
            <list create="false"><field name="event_date"/><field name="event_type"/><field name="reference"/>
                <field name="related_model"/><field name="user_id"/><field name="description"/></list>
        </field>
    </record>
    <record id="view_audit_search" model="ir.ui.view">
        <field name="name">procurement.audit.log.search</field><field name="model">procurement.audit.log</field>
        <field name="arch" type="xml">
            <search><field name="reference"/><field name="event_type"/>
                <filter name="group_event" string="Event" context="{'group_by':'event_type'}"/>
                <filter name="group_model" string="Model" context="{'group_by':'related_model'}"/>
            </search>
        </field>
    </record>
    <record id="action_audit" model="ir.actions.act_window">
        <field name="name">Audit Logs</field><field name="res_model">procurement.audit.log</field><field name="view_mode">list</field>
        <field name="search_view_id" ref="view_audit_search"/>
    </record>
</odoo>
