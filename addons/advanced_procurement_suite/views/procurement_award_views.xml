<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_award_list" model="ir.ui.view">
        <field name="name">procurement.award.list</field><field name="model">procurement.award</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending_approval'" decoration-success="state in ('approved','converted_to_po')" decoration-muted="state == 'cancelled'">
                <field name="name"/><field name="vendor_id"/><field name="total_awarded_amount" sum="Awarded"/>
                <field name="savings_amount" sum="Savings"/><field name="approval_state" widget="badge"/><field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_award_form" model="ir.ui.view">
        <field name="name">procurement.award.form</field><field name="model">procurement.award</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request_approval" type="object" string="Request Approval" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve Award" class="btn-primary" invisible="state not in ('draft','pending_approval')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('pending_approval',)"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled','converted_to_po')"/>
                    <button name="action_view_audit" type="object" string="Audit"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not risk_warning"><field name="risk_warning"/></div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group>
                        <field name="rfq_event_id"/><field name="vendor_id"/><field name="vendor_quote_id"/>
                        <field name="award_date"/><field name="awarded_by"/><field name="approval_state"/>
                    </group><group>
                        <field name="estimated_total"/><field name="total_awarded_amount"/><field name="savings_amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group></group>
                    <field name="award_line_ids">
                        <list editable="bottom">
                            <field name="product_id"/><field name="description"/><field name="awarded_quantity"/>
                            <field name="unit_price"/><field name="subtotal"/><field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer"><field name="total_awarded_amount"/></group>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_award_search" model="ir.ui.view">
        <field name="name">procurement.award.search</field><field name="model">procurement.award</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="vendor_id"/>
                <filter name="pending" string="Pending Approval" domain="[('state','=','pending_approval')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="high_savings" string="High Savings" domain="[('savings_amount','&gt;',0)]"/>
                <filter name="group_vendor" string="Vendor" context="{'group_by':'vendor_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>
    <record id="action_award" model="ir.actions.act_window">
        <field name="name">Awards</field><field name="res_model">procurement.award</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_award_search"/>
    </record>
</odoo>
