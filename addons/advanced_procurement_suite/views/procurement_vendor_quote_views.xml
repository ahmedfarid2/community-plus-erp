<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quote_list" model="ir.ui.view">
        <field name="name">procurement.vendor.quote.list</field><field name="model">procurement.vendor.quote</field>
        <field name="arch" type="xml">
            <list decoration-success="is_recommended" decoration-muted="state in ('rejected','cancelled')">
                <field name="name"/><field name="vendor_id"/><field name="total_amount"/><field name="delivery_date"/>
                <field name="price_score"/><field name="total_score"/><field name="is_recommended"/><field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_quote_form" model="ir.ui.view">
        <field name="name">procurement.vendor.quote.form</field><field name="model">procurement.vendor.quote</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit Quote" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_shortlist" type="object" string="Shortlist" invisible="state != 'submitted'"/>
                    <button name="action_award" type="object" string="Award" class="btn-primary" invisible="state not in ('submitted','shortlisted')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state in ('rejected','cancelled','awarded')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,shortlisted,awarded"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group>
                        <field name="rfq_event_id"/><field name="vendor_id"/><field name="quote_date"/>
                        <field name="validity_date"/><field name="delivery_date"/><field name="payment_terms"/>
                    </group><group>
                        <field name="price_score"/><field name="delivery_score"/><field name="quality_score"/>
                        <field name="risk_score"/><field name="total_score"/><field name="is_recommended"/>
                    </group></group>
                    <field name="quote_line_ids">
                        <list editable="bottom">
                            <field name="product_id"/><field name="description"/><field name="quantity"/>
                            <field name="unit_price"/><field name="discount_percent"/><field name="subtotal"/>
                            <field name="delivery_days"/><field name="alternative_product"/><field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="subtotal_amount"/><field name="discount_amount"/><field name="tax_amount"/><field name="total_amount"/>
                    </group>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_quote" model="ir.actions.act_window">
        <field name="name">Vendor Quotes</field><field name="res_model">procurement.vendor.quote</field><field name="view_mode">list,form</field>
    </record>
</odoo>
