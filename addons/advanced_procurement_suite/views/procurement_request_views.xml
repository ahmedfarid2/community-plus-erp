<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_request_list" model="ir.ui.view">
        <field name="name">procurement.request.list</field><field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'" decoration-success="state in ('approved','completed')" decoration-muted="state in ('rejected','cancelled')">
                <field name="name"/><field name="requester_id"/><field name="request_type"/><field name="priority" widget="priority"/>
                <field name="needed_by_date"/><field name="estimated_total_amount" sum="Estimated"/><field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_request_form" model="ir.ui.view">
        <field name="name">procurement.request.form</field><field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Review" invisible="state != 'submitted'"/>
                    <button name="action_create_rfq" type="object" string="Create RFQ Event" class="btn-primary" invisible="state not in ('under_review','approved') or rfq_event_id"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state not in ('submitted','under_review')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state in ('rejected','cancelled','completed')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled','completed')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state in ('draft','completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,rfq_created"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rfq" type="object" class="oe_stat_button" icon="fa-gavel" invisible="not rfq_event_id"><field name="rfq_count" widget="statinfo" string="RFQ"/></button>
                        <button name="action_view_audit" type="object" class="oe_stat_button" icon="fa-history"><field name="audit_count" widget="statinfo" string="Audit"/></button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group>
                        <field name="requester_id"/><field name="responsible_user_id"/><field name="request_type"/><field name="priority" widget="priority"/>
                    </group><group>
                        <field name="request_date"/><field name="needed_by_date"/><field name="currency_id" groups="base.group_multi_currency"/>
                        <field name="rfq_event_id"/>
                    </group></group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/><field name="description"/><field name="quantity"/><field name="uom_id"/>
                                    <field name="estimated_unit_price"/><field name="estimated_subtotal"/><field name="required_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer"><field name="estimated_total_amount"/></group>
                        </page>
                        <page string="Justification"><field name="justification"/></page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_request_search" model="ir.ui.view">
        <field name="name">procurement.request.search</field><field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="requester_id"/>
                <filter name="my" string="My Requests" domain="[('requester_id','=',uid)]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="under_review" string="Under Review" domain="[('state','=','under_review')]"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                <filter name="group_type" string="Type" context="{'group_by':'request_type'}"/>
            </search>
        </field>
    </record>
    <record id="action_request" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field><field name="res_model">procurement.request</field><field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_request_search"/>
    </record>
</odoo>
