<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_criteria_list" model="ir.ui.view">
        <field name="name">procurement.evaluation.criteria.list</field><field name="model">procurement.evaluation.criteria</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="code"/><field name="weight_percent"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>
    <record id="action_criteria" model="ir.actions.act_window">
        <field name="name">Evaluation Criteria</field><field name="res_model">procurement.evaluation.criteria</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_category_list" model="ir.ui.view">
        <field name="name">procurement.vendor.category.list</field><field name="model">procurement.vendor.category</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="code"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>
    <record id="action_category" model="ir.actions.act_window">
        <field name="name">Vendor Categories</field><field name="res_model">procurement.vendor.category</field><field name="view_mode">list,form</field>
    </record>
</odoo>
