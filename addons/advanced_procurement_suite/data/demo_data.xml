<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_crit_price" model="procurement.evaluation.criteria"><field name="name">Price</field><field name="code">price</field><field name="weight_percent">40</field></record>
        <record id="demo_crit_delivery" model="procurement.evaluation.criteria"><field name="name">Delivery Time</field><field name="code">delivery</field><field name="weight_percent">20</field></record>
        <record id="demo_crit_quality" model="procurement.evaluation.criteria"><field name="name">Quality</field><field name="code">quality</field><field name="weight_percent">25</field></record>
        <record id="demo_crit_risk" model="procurement.evaluation.criteria"><field name="name">Vendor Risk</field><field name="code">risk</field><field name="weight_percent">15</field></record>

        <record id="demo_cat_raw" model="procurement.vendor.category"><field name="name">Raw Materials</field><field name="code">RAW</field></record>
        <record id="demo_cat_it" model="procurement.vendor.category"><field name="name">IT Equipment</field><field name="code">IT</field></record>
        <record id="demo_cat_maint" model="procurement.vendor.category"><field name="name">Maintenance Services</field><field name="code">MNT</field></record>

        <record id="demo_vp_1" model="procurement.vendor.profile">
            <field name="partner_id" ref="base.res_partner_12"/><field name="risk_level">low</field>
            <field name="preferred_vendor" eval="True"/><field name="vendor_category_ids" eval="[(6,0,[ref('demo_cat_raw')])]"/>
        </record>
        <record id="demo_vp_2" model="procurement.vendor.profile">
            <field name="partner_id" ref="base.res_partner_10"/><field name="risk_level">medium</field>
            <field name="vendor_category_ids" eval="[(6,0,[ref('demo_cat_it')])]"/>
        </record>
        <record id="demo_vp_3" model="procurement.vendor.profile">
            <field name="partner_id" ref="base.res_partner_4"/><field name="risk_level">high</field>
        </record>

        <record id="demo_request" model="procurement.request">
            <field name="request_type">product</field><field name="priority">high</field>
            <field name="justification">Restock for Q3 production.</field>
        </record>
        <record id="demo_req_l1" model="procurement.request.line">
            <field name="request_id" ref="demo_request"/><field name="description">Steel sheets 2mm</field>
            <field name="quantity">100</field><field name="estimated_unit_price">25</field>
        </record>

        <record id="demo_contract" model="procurement.vendor.contract">
            <field name="vendor_id" ref="base.res_partner_12"/><field name="contract_type">Supply Agreement</field>
            <field name="state">active</field><field name="contract_value">50000</field>
            <field name="start_date" eval="(DateTime.today()-relativedelta(months=11)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(DateTime.today()+relativedelta(days=20)).strftime('%Y-%m-%d')"/>
        </record>
    </data>
</odoo>
