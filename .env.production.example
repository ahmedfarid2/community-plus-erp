# ── Odoo Community PRODUCTION env ──────────────────────────────────────────
# Copy to ".env.production" on the server and fill in real values.

ODOO_TAG=19.0
PG_TAG=16

# Your real domain. Companies live at <company>.DOMAIN (e.g. acme.example.com).
# Requires a wildcard DNS A record:  *.example.com -> server IP  (and example.com).
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# STRONG, unique secrets — do not reuse the local dev values.
POSTGRES_PASSWORD=CHANGE_ME_long_random
MASTER_PASSWORD=CHANGE_ME_long_random

# Optional SMTP settings can be rendered into custom Odoo config or configured in
# Settings after deployment. Keep client-specific mail credentials out of git.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
